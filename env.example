# The library does not read this file. Ignored E2E tests read process variables.
E2E_IMAGE_PATH=samples/red-square.png

# vLLM
VLLM_MODELS_URL=http://127.0.0.1:8000/v1/models
VLLM_CONFIGURED_MODEL=
VLLM_PIPELINE_ID=
VLLM_DIMENSIONS=
VLLM_SEND_DIMENSIONS=false
VLLM_API_KEY=
VLLM_ALLOW_REMOTE_HTTP=false

# llama.cpp
LLAMA_CPP_MODELS_URL=http://127.0.0.1:8080/v1/models
LLAMA_CPP_CONFIGURED_MODEL=
LLAMA_CPP_PIPELINE_ID=
LLAMA_CPP_DIMENSIONS=
LLAMA_CPP_MEDIA_MARKER=
LLAMA_CPP_ALLOW_REMOTE_HTTP=false

# DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
DASHSCOPE_CONFIGURED_MODEL=qwen3-vl-embedding
DASHSCOPE_PIPELINE_ID=
DASHSCOPE_NATIVE_DIMENSIONS=
DASHSCOPE_DIMENSIONS=

# DashScope-compatible enterprise endpoint
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=
DASHSCOPE_ENTERPRISE_CONFIGURED_MODEL=
DASHSCOPE_ENTERPRISE_PIPELINE_ID=
DASHSCOPE_ENTERPRISE_NATIVE_DIMENSIONS=
DASHSCOPE_ENTERPRISE_DIMENSIONS=
DASHSCOPE_ENTERPRISE_ALLOW_REMOTE_HTTP=false

# SGLang v0.5.11+ standard /v1/embeddings endpoint
SGLANG_MODELS_URL=http://127.0.0.1:30000/v1/models
SGLANG_MODEL=
SGLANG_PIPELINE_ID=
SGLANG_DIMENSIONS=
SGLANG_API_KEY=
SGLANG_ALLOW_REMOTE_HTTP=false
# Server-accessible URL/path or bare base64; data:video URLs are not promised.
SGLANG_VIDEO_SOURCE=
